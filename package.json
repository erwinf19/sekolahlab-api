{
  "name": "sekolahlab-api",
  "version": "0.1.0",
  "private": true,
  "description": "Dummy school API for frontend learning, powered by static JSON.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "setup": "node scripts/setup.js"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "serverless-http": "4.0.0"
  }
}
